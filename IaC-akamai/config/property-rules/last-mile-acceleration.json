{
    "rules": {
        "name": "Last Mile Acceleration",
        "children": [
            {
                "name": "Enable Last Mile Acceleration",
                "children": [],
                "behaviors": [
                    {
                        "name": "gzipResponse",
                        "options": {
                            "behavior": "ALWAYS"
                        }
                    }
                ],
                "criteria": [
                    {
                        "name": "contentType",
                        "options": {
                            "matchCaseSensitive": false,
                            "matchOperator": "IS_ONE_OF",
                            "matchWildcard": true,
                            "values": [
                                "application/*javascript*",
                                "application/*json*",
                                "application/*xml*",
                                "application/text*",
                                "application/vnd-ms-fontobject",
                                "application/vnd.microsoft.icon",
                                "application/x-font-opentype",
                                "application/x-font-truetype",
                                "application/x-font-ttf",
                                "application/xmlfont/eot",
                                "font/eot",
                                "font/opentype",
                                "font/otf",
                                "image/svg+xml",
                                "image/vnd.microsoft.icon",
                                "image/x-icon",
                                "text/*",
                                "application/octet-stream*",
                                "application/x-font-eot*",
                                "font/ttf",
                                "application/font-ttf",
                                "application/font-sfnt",
                                "application/x-tgif",
                                "text/html*",
                                "application/x-javascript*",
                                "text/css*",
                                "application/javascript*",
                                "application/json*",
                                "application/font-woff*",
                                "image/gif*",
                                "image/jpeg*",
                                "image/png*",
                                "text/javascript*",
                                "text/xml*",
                                "text/plain*"
                            ]
                        }
                    }
                ],
                "criteriaMustSatisfy": "all",
                "comments": "Serve gzip compressed content for text-based formats."
            },
            {
                "name": "Disable for Old IE browsers",
                "children": [],
                "behaviors": [
                    {
                        "name": "gzipResponse",
                        "options": {
                            "behavior": "NEVER"
                        }
                    }
                ],
                "criteria": [
                    {
                        "name": "userAgent",
                        "options": {
                            "matchOperator": "IS_ONE_OF",
                            "values": [
                                "*MSIE 5*Mac*",
                                "*MSIE 4*"
                            ],
                            "matchCaseSensitive": false,
                            "matchWildcard": true
                        }
                    }
                ],
                "criteriaMustSatisfy": "any",
                "comments": "Disables last mile compression for old Internet Explorer browsers"
            },
            {
                "name": "Disable for Old Mozilla browsers",
                "children": [],
                "behaviors": [
                    {
                        "name": "gzipResponse",
                        "options": {
                            "behavior": "NEVER"
                        }
                    }
                ],
                "criteria": [
                    {
                        "name": "userAgent",
                        "options": {
                            "matchOperator": "IS_ONE_OF",
                            "values": [
                                "*Mozilla/4*"
                            ],
                            "matchCaseSensitive": false,
                            "matchWildcard": true
                        }
                    },
                    {
                        "name": "userAgent",
                        "options": {
                            "matchOperator": "IS_NOT_ONE_OF",
                            "values": [
                                "*(compatible;*"
                            ],
                            "matchCaseSensitive": false,
                            "matchWildcard": true
                        }
                    }
                ],
                "criteriaMustSatisfy": "all",
                "comments": "Disables last mile compression for old Mozilla browsers"
            }
        ],
        "behaviors": [],
        "criteria": [],
        "criteriaMustSatisfy": "any",
        "comments": "Replicates Config Manager's 'Last Mile Acceleration': 'Disable for Old Browsers' logic. Config Manger's description: 'Do not use Last Mile Acceleration for the following browsers: MSIE 4, MSIE 5( Mac), and all Mozilla 4. These older browsers incorrectly advertise they support gzip compression.'"
    }
}